{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "api/index.py",
      "headers": {
        "x-original-path": "/api/$1"
      }
    },
    {
      "src": "/health",
      "dest": "api/index.py",
      "headers": {
        "x-original-path": "/health"
      }
    },
    {
      "src": "/query",
      "dest": "api/index.py",
      "headers": {
        "x-original-path": "/query"
      }
    },
    {
      "src": "/reindex",
      "dest": "api/index.py",
      "headers": {
        "x-original-path": "/reindex"
      }
    }
  ]
}