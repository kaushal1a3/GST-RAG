{
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/health",
      "destination": "/api/index.py"
    },
    {
      "source": "/query",
      "destination": "/api/index.py"
    },
    {
      "source": "/reindex",
      "destination": "/api/index.py"
    }
  ]
}