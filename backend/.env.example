# ---------------------------------------------------------------------------
# Backend Environment Configuration (FastAPI)
# ---------------------------------------------------------------------------

# 1. Gemini API Key (Required for LLM generation & query routing)
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Qdrant Cloud Vector Database (Required for Vercel Cloud Retrieval)
# Get your free Cluster URL and API Key from https://cloud.qdrant.io
QDRANT_URL=https://your-cluster-id.us-east4-0.gcp.cloud.qdrant.io
QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_COLLECTION=gst_leaf_chunks

# 3. Allowed Frontend Origins for CORS (Comma-separated)
# Set this to your Vercel Frontend URL to prevent CORS issues
# Example: https://gst-rag-frontend.vercel.app,http://localhost:5173
ALLOWED_ORIGINS=https://your-frontend-domain.vercel.app,http://localhost:5173

# 4. System Logging Level
LOG_LEVEL=INFO
